{
  "schemaVersion": 1,
  "id": "oresim",
  "version": "${version}",
  "name": "OreSim by gumark",
  "description": "Simulates world ore generation from a seed and renders every ore through walls. Set a seed with /setoresimseed and toggle with X.",
  "authors": [
    "gumark"
  ],
  "contributors": [
    "oHfok"
  ],
  "contact": {
    "sources": "https://github.com/oHfok/fabric-oresim",
    "issues": "https://github.com/oHfok/fabric-oresim/issues"
  },
  "license": "GPL-3.0-only",
  "environment": "client",
  "entrypoints": {
    "client": [
      "dev.gumark.oresim.OreSimClient"
    ]
  },
  "mixins": [
    "oresim.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=0.19.0",
    "minecraft": "~${minecraft}",
    "java": ">=${java}",
    "fabric-api": "*"
  },
  "suggests": {
    "baritone": "*"
  }
}
