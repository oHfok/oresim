{
  "schemaVersion": 1,
  "id": "oresim",
  "version": "${version}",
  "name": "OreSim by krwawiec",
  "description": "Predicts ores from the world seed and shows them through walls, even behind anti-xray; optional Baritone auto-mining. Toggle with X, settings with O. Based on gumark's standalone port of meteor-rejects' OreSim.",
  "authors": [
    "krwawiec"
  ],
  "contributors": [
    "gumark (original standalone port)"
  ],
  "contact": {
    "sources": "https://github.com/oHfok/fabric-oresim",
    "issues": "https://github.com/oHfok/fabric-oresim/issues"
  },
  "license": "GPL-3.0-only",
  "environment": "client",
  "entrypoints": {
    "client": [
      "dev.gumark.oresim.OreSimClient"
    ]
  },
  "mixins": [
    "oresim.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=0.19.0",
    "minecraft": "~${minecraft}",
    "java": ">=${java}",
    "fabric-api": "*"
  },
  "suggests": {
    "baritone": "*"
  }
}
